# kevins-terminal zsh profile. Symlinked to ~/.zshrc by install.sh.
# Machine-specific settings belong in ~/.zshrc.local, not here.

# Repo root, resolved through the ~/.zshrc symlink.
export DOTFILES="${${(%):-%x}:A:h:h}"

# --- PATH -------------------------------------------------------------------
typeset -U path fpath
path=(
  $HOME/.local/bin
  /opt/homebrew/bin(N) /opt/homebrew/sbin(N)
  $path
)

# --- Oh My Zsh --------------------------------------------------------------
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""                           # prompt is Pure, loaded below
zstyle ':omz:update' mode disabled     # no update check at startup; use `termup`
ZSH_DISABLE_COMPFIX=true               # skip the compaudit permission scan
DISABLE_MAGIC_FUNCTIONS=true           # no url-quote-magic on paste
DISABLE_AUTO_TITLE=true                # titles are set below
plugins=(git)

if [[ -r $ZSH/oh-my-zsh.sh ]]; then
  source $ZSH/oh-my-zsh.sh
else
  print -u2 "zshrc: Oh My Zsh not found, run $DOTFILES/install.sh"
fi

# --- History ----------------------------------------------------------------
HISTSIZE=50000
SAVEHIST=50000
setopt hist_ignore_all_dups hist_reduce_blanks

# --- Editing ----------------------------------------------------------------
# Option+Backspace deletes one word (stopping at / - . and other punctuation).
# Ctrl+W deletes a whole argument: a full path, or a quoted string.
autoload -Uz backward-kill-word-match
zle -N backward-kill-arg backward-kill-word-match
zstyle ':zle:backward-kill-arg' word-style shell
bindkey '^W' backward-kill-arg
bindkey '^[^?' backward-kill-word

# --- Prompt: Pure (current directory + git branch, git work done async) ------
PURE_GIT_PULL=0                        # never `git fetch` in the background
zstyle ':prompt:pure:title' show false # titles are set below
pure_dir="${ZSH_CUSTOM:-$ZSH/custom}/pure"
if [[ -r $pure_dir/pure.zsh ]]; then
  fpath+=($pure_dir)
  autoload -U promptinit && promptinit
  prompt pure
else
  PROMPT='%F{blue}%~%f %# '
fi
unset pure_dir

# --- Titles -----------------------------------------------------------------
# Tab title is "dir" at the prompt and "dir: command" while something runs,
# prefixed with the host over SSH. Inside tmux, windows show the directory only.
_title_set() {
  printf '\e]0;%s\a' "${SSH_CONNECTION:+${HOST%%.*}: }${(%):-%1~}${1:+: $1}"
}
_title_precmd() { _title_set }
_title_preexec() {
  local -a words=(${(z)1})
  # Skip leading VAR=value assignments, sudo and its flags to find the command.
  while [[ $words[1] == (*=*|sudo|-*) ]]; do shift words; done
  _title_set "${(V)words[1]:t}"
}
autoload -Uz add-zsh-hook
add-zsh-hook precmd _title_precmd
add-zsh-hook preexec _title_preexec

# --- Updating ---------------------------------------------------------------
# Pull the latest config, then update Oh My Zsh and Pure.
termup() {
  git -C "$DOTFILES" pull --ff-only 2>/dev/null \
    || print -u2 "termup: skipped config pull (no remote, or local changes)"
  "$DOTFILES/install.sh" && exec zsh
}

# --- Local overrides --------------------------------------------------------
[[ -r $HOME/.zshrc.local ]] && source $HOME/.zshrc.local
